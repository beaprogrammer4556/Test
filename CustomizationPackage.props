<Project>
  <Import Project="./repo.props" />

  <PropertyGroup>
    <PackagePublisher Condition="'$(PackagePublisher)' == ''">$(Publisher)</PackagePublisher>
    <PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)' == ''">$(PublisherDisplayName)</PackagePublisherDisplayName>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <PackageName Condition="'$(PackageName)' == ''">Nimbus.StoreCommerce</PackageName>
    <PackageDisplayName Condition="'$(PackageDisplayName)' == ''">Nimbus Retail Practice</PackageDisplayName>
    <PackageDescription Condition="'$(PackageDescription)' == ''">Nimbus Retail Practice</PackageDescription>
  </PropertyGroup>
</Project>